{
    "name": "batisaas/application",
    "description": "Application SaaS de gestion pour entreprises du bâtiment",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "saas",
        "batiment",
        "construction",
        "gestion",
        "devis",
        "factures",
        "chantiers"
    ],
    "authors": [
        {
            "name": "BatiSaaS Team",
            "email": "contact@batisaas.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "suggest": {
        "phpmailer/phpmailer": "Pour l'envoi d'emails",
        "tecnickcom/tcpdf": "Pour la génération de PDF",
        "mpdf/mpdf": "Alternative pour la génération de PDF"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/Helpers.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
