# ============================================================================
# BATISAAS - CONFIGURATION DE L'APPLICATION
# ============================================================================
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement
# Ne jamais committer le fichier .env (contient des informations sensibles)
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
APP_NAME=BatiSaaS
APP_URL=http://localhost
APP_VERSION=2.0.0
APP_ENV=production
DEBUG_MODE=false

# Clé secrète pour le chiffrement (générez une valeur aléatoire unique)
# Commande: openssl rand -base64 32
APP_KEY=

# ----------------------------------------------------------------------------
# BASE DE DONNÉES
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=batisaas
DB_USER=batisaas_user
DB_PASS=changez_moi_en_production
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Pool de connexions
DB_POOL_MIN=5
DB_POOL_MAX=20

# ----------------------------------------------------------------------------
# EMAIL / SMTP
# ----------------------------------------------------------------------------
# Configuration SMTP pour l'envoi d'emails
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USERNAME=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-app
SMTP_FROM_EMAIL=noreply@batisaas.com
SMTP_FROM_NAME=BatiSaaS

# Pour Gmail, utilisez un "mot de passe d'application"
# https://support.google.com/accounts/answer/185833

# ----------------------------------------------------------------------------
# SÉCURITÉ
# ----------------------------------------------------------------------------
# Salt pour le hashage (générez une valeur aléatoire unique)
SECURITY_SALT=changez_cette_valeur_unique_en_production

# CSRF Protection
CSRF_ENABLED=true
CSRF_TOKEN_NAME=csrf_token
CSRF_COOKIE_NAME=csrf_cookie

# Politique de mots de passe
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=false

# Tentatives de connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# ----------------------------------------------------------------------------
# SESSIONS
# ----------------------------------------------------------------------------
SESSION_LIFETIME=7200
SESSION_NAME=BATISAAS_SESSION
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# ----------------------------------------------------------------------------
# UPLOADS & STOCKAGE
# ----------------------------------------------------------------------------
# Taille maximale des fichiers uploadés
MAX_UPLOAD_SIZE=50M
POST_MAX_SIZE=52M

# Types de fichiers autorisés
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,txt
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,zip

# Chemins de stockage
UPLOAD_PATH=public/uploads
PHOTO_PATH=public/uploads/photos
DOCUMENT_PATH=public/uploads/documents
THUMBNAIL_PATH=public/uploads/thumbnails
LOGO_PATH=public/uploads/logos

# Génération automatique de thumbnails
THUMBNAIL_ENABLED=true
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300
THUMBNAIL_QUALITY=85

# ----------------------------------------------------------------------------
# API REST
# ----------------------------------------------------------------------------
# Rate limiting (limite de requêtes par IP)
API_ENABLED=true
API_RATE_LIMIT=60
API_RATE_LIMIT_PERIOD=60

# Token API
API_TOKEN_LIFETIME=2592000
API_TOKEN_REFRESH_ENABLED=true

# CORS (Cross-Origin Resource Sharing)
API_CORS_ENABLED=true
API_CORS_ALLOWED_ORIGINS=*
API_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
API_CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ----------------------------------------------------------------------------
# LOCALISATION & FORMAT
# ----------------------------------------------------------------------------
LOCALE=fr_FR
TIMEZONE=Europe/Paris
CURRENCY=EUR
CURRENCY_SYMBOL=€
CURRENCY_DECIMALS=2
DATE_FORMAT=d/m/Y
TIME_FORMAT=H:i
DATETIME_FORMAT=d/m/Y H:i

# ----------------------------------------------------------------------------
# PAGINATION
# ----------------------------------------------------------------------------
ITEMS_PER_PAGE=25
MAX_ITEMS_PER_PAGE=100

# ----------------------------------------------------------------------------
# LOGS
# ----------------------------------------------------------------------------
LOG_ENABLED=true
LOG_LEVEL=info
LOG_FILE=storage/logs/app.log
LOG_MAX_SIZE=10M
LOG_MAX_FILES=10

# Niveaux disponibles: debug, info, warning, error, critical

# ----------------------------------------------------------------------------
# CACHE
# ----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_DRIVER=file
CACHE_PATH=storage/cache
CACHE_TTL=3600

# Drivers disponibles: file, memcached, redis

# ----------------------------------------------------------------------------
# PWA (PROGRESSIVE WEB APP)
# ----------------------------------------------------------------------------
PWA_ENABLED=true
PWA_NAME=BatiSaaS
PWA_SHORT_NAME=BatiSaaS
PWA_THEME_COLOR=#2563eb
PWA_BACKGROUND_COLOR=#ffffff
PWA_OFFLINE_ENABLED=true

# ----------------------------------------------------------------------------
# NOTIFICATIONS
# ----------------------------------------------------------------------------
# Notifications par email
NOTIFICATIONS_EMAIL_ENABLED=true

# Notifications push (Web Push)
NOTIFICATIONS_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server-Sent Events (SSE)
NOTIFICATIONS_SSE_ENABLED=true

# ----------------------------------------------------------------------------
# BACKUPS
# ----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true

# Sauvegarde automatique
BACKUP_AUTO_ENABLED=false
BACKUP_AUTO_SCHEDULE=0 2 * * *

# ----------------------------------------------------------------------------
# MAINTENANCE
# ----------------------------------------------------------------------------
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Application en maintenance. Retour prévu dans quelques minutes.
MAINTENANCE_ALLOWED_IPS=127.0.0.1

# ----------------------------------------------------------------------------
# ANALYTICS & MONITORING
# ----------------------------------------------------------------------------
ANALYTICS_ENABLED=false
ANALYTICS_GOOGLE_ID=

# Monitoring
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ----------------------------------------------------------------------------
# INTÉGRATIONS TIERCES
# ----------------------------------------------------------------------------
# Google Maps
GOOGLE_MAPS_API_KEY=

# Stripe (paiements)
STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (SMS)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ----------------------------------------------------------------------------
# DÉVELOPPEMENT (Ne pas utiliser en production)
# ----------------------------------------------------------------------------
# Affichage détaillé des erreurs
DEV_ERROR_REPORTING=E_ALL
DEV_DISPLAY_ERRORS=false

# Profiling
DEV_PROFILING_ENABLED=false

# SQL Query logging
DEV_SQL_LOGGING=false

# ----------------------------------------------------------------------------
# MULTI-TENANT
# ----------------------------------------------------------------------------
# Isolation des données par entreprise
MULTI_TENANT_ENABLED=true

# Quota par défaut (par entreprise)
TENANT_MAX_USERS=50
TENANT_MAX_PROJECTS=100
TENANT_MAX_STORAGE_GB=10

# ----------------------------------------------------------------------------
# FACTURATION & ABONNEMENTS
# ----------------------------------------------------------------------------
# Plans disponibles
SUBSCRIPTION_ENABLED=false
SUBSCRIPTION_PLANS=basic,pro,enterprise

# Trial period (jours)
SUBSCRIPTION_TRIAL_DAYS=30

# ----------------------------------------------------------------------------
# RGPD & CONFORMITÉ
# ----------------------------------------------------------------------------
# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# Données personnelles
GDPR_ENABLED=true
GDPR_ANONYMIZATION_ENABLED=true
GDPR_DATA_RETENTION_DAYS=1095

# Cookie consent
COOKIE_CONSENT_ENABLED=true
