# Configuration de l'application
APP_NAME=BatiSaaS
APP_URL=http://localhost
APP_VERSION=1.0.0
DEBUG_MODE=true

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_NAME=batisaas
DB_USER=batisaas_user
DB_PASS=votre_mot_de_passe
DB_CHARSET=utf8mb4

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=noreply@batisaas.com
SMTP_FROM_NAME=BatiSaaS

# Sécurité
SALT=changez_cette_valeur_en_production

# Sessions
SESSION_LIFETIME=7200

# Upload
MAX_UPLOAD_SIZE=10M
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# API
API_RATE_LIMIT=60
API_RATE_LIMIT_PERIOD=60

# Locale
LOCALE=fr_FR
TIMEZONE=Europe/Paris
CURRENCY=EUR
CURRENCY_SYMBOL=€

# Pagination
ITEMS_PER_PAGE=20

# Logs
LOG_LEVEL=info
LOG_FILE=storage/logs/app.log
